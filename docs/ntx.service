# systemd unit for ntx
#
# Install:
#   sudo cp docs/ntx.service /etc/systemd/system/ntx.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ntx
#
# Adjust User, WorkingDirectory, and ExecStart to match your install.
# WorkingDirectory must contain ntx.toml (and static/, templates/, ntx.db
# unless those paths are set absolute in ntx.toml).

[Unit]
Description=ntx personal site server
After=network.target

[Service]
Type=simple
User=ntx
Group=ntx
WorkingDirectory=/opt/ntx
ExecStart=/opt/ntx/ntx serve
Restart=on-failure
RestartSec=5s

# graceful shutdown drains in-flight requests for up to 30s (main.go)
TimeoutStopSec=35s

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ntx
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
